<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the save copy goes to the Google account backup and to a new phone; nothing else does -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="bob_cloud.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="bob_cloud.xml" />
    </device-transfer>
</data-extraction-rules>
