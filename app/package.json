    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "cordova-plugin-purchase": "^13.18.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2"
  }
}
